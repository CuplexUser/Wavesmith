{
  "name": "wavesmith-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "node ../scripts/build-wasm.mjs",
    "dev": "node ../scripts/build-wasm.mjs --if-stale && vite",
    "build": "node ../scripts/build-wasm.mjs --if-stale && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:native": "node ../scripts/build-wasm.mjs --if-stale && tsc --noEmit && WAVESMITH_BASE=./ vite build && cap sync android",
    "android": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "binaryen": "132.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1"
  }
}
